ENTRA_TENANT_ID=<tenant-guid>
ENTRA_BLUEPRINT_CLIENT_ID=<blueprint-app-guid>
ENTRA_BLUEPRINT_CLIENT_SECRET=<local-demo-secret>
ENTRA_AGENT_ID=<child-agent-guid>
MCP_API_CLIENT_ID=<mcp-api-app-guid>
MCP_HOST=127.0.0.1
MCP_PORT=8000

AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<existing-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_NAME=<existing-deployment>
OPENAI_API_VERSION=2024-10-21

# off preserves the original demo; console traces locally; agent365 exports to the tenant.
A365_TELEMETRY_MODE=off